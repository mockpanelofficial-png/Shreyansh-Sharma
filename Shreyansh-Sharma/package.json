{
  "name": "shreyansh-sharma-portfolio",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "node --watch server/index.js",
    "client": "npm --prefix client run dev",
    "start": "node server/index.js",
    "build": "npm --prefix client run build",
    "postinstall": "npm --prefix client install"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cloudinary": "^2.10.1",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.15.1",
    "multer": "^2.2.0"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}